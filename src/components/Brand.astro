---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { site } from '../data/projects';
---

<Image class="logo" src={logo} alt={site.name} densities={[1, 2]} loading="eager" />

<style>
  .logo {
    height: 2.5rem;
    width: auto;
  }

  @media (max-width: 30rem) {
    .logo { height: 2rem; }
  }
</style>
