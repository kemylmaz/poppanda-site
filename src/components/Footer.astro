---
import SocialLinks from './SocialLinks.astro';
import { useTranslations, localizePath, type Lang } from '../i18n/ui';
import { site } from '../data/projects';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();

const nav = [
  { href: '/games', label: t('nav.games') },
  { href: '/video', label: t('nav.video') },
  { href: '/about', label: t('nav.about') },
];
---

<footer class="site-foot">
  <div class="wrap">
    <div class="call">
      <h2>{t('contact.title')}</h2>
      <p class="lead">{t('contact.lead')}</p>
      <a class="mail" href={`mailto:${site.email}`}>{site.email}</a>
    </div>

    <div class="cols">
      <nav aria-label={t('nav.primary')}>
        <ul>
          {nav.map((item) => (
            <li><a href={localizePath(item.href, lang)}>{item.label}</a></li>
          ))}
        </ul>
      </nav>

      <SocialLinks links={site.links} size="small" />
    </div>

    <p class="fine">© {year} {site.name}. {t('footer.rights')}</p>
  </div>
</footer>

<style>
  .site-foot {
    background: var(--navy-deep);
    color: var(--bg);
    border-top: 3px solid var(--line);
    padding-block: var(--space-6) var(--space-5);
    margin-top: var(--space-7);
    --ink: var(--bg);
    --ink-soft: #B7AEE8;
    --surface: #221A5E;
    --line: var(--bg);
    --shadow-color: #0B0824;
  }

  .call { margin-bottom: var(--space-5); }
  .call h2 { font-size: var(--step-4); margin-bottom: 0.15em; }
  .call .lead { color: var(--ink-soft); }

  .mail {
    display: inline-block;
    margin-top: var(--space-3);
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 800;
    color: var(--yellow);
    text-decoration-color: transparent;
    transition: text-decoration-color var(--fast) var(--ease-out);
    word-break: break-word;
  }

  .mail:hover { text-decoration-color: var(--yellow); }

  .cols {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-4);
    padding-top: var(--space-4);
    border-top: 3px solid rgba(255, 246, 220, 0.3);
  }

  .cols ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .cols nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-display);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    text-decoration: none;
  }

  .cols nav a:hover { text-decoration: underline; text-decoration-color: var(--orange); }

  .fine {
    margin: var(--space-4) 0 0;
    font-size: var(--step--1);
    color: var(--ink-soft);
  }
</style>
