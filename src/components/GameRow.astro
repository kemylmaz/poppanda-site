---
import { useTranslations, localizePath, type Lang } from '../i18n/ui';
import type { Game } from '../data/projects';

interface Props { game: Game; lang: Lang; index: number }
const { game, lang, index } = Astro.props;
const t = useTranslations(lang);
const number = String(index + 1).padStart(2, '0');
---

{/* The whole row leads to the game's page; when there is something to play, a
    second link sits on top of it and goes straight to the build. */}
<div class:list={['row', { 'row--with-cover': game.cover }]} style={`--row-accent:${game.accent}`} data-reveal>
  <span class="num" aria-hidden="true">{number}</span>

  <span class:list={['body', { 'body--with-cover': game.cover }]}>
    {game.cover && (
      <span class="art" aria-hidden="true">
        <img
          src={game.cover}
          alt=""
          width="512"
          height="512"
          loading="lazy"
          decoding="async"
        />
      </span>
    )}

    <span class="copy">
      <span class="title">
        <h3>
          <a class="cover" href={localizePath(`/games/${game.slug}`, lang)}>{game.title}</a>
        </h3>
        {game.formerTitle && <span class="former">ex · {game.formerTitle}</span>}
      </span>
      <span class="tagline">{game.tagline[lang]}</span>
    </span>
  </span>

  <span class="meta">
    <span class="tag" style="--tag-dot: var(--row-accent)">{t(`status.${game.status}`)}</span>
    {game.platforms && <span class="platforms">{game.platforms.join(' · ')}</span>}
  </span>

  {game.playUrl ? (
    <a class="play" href={game.playUrl} target="_blank" rel="noopener">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
        <path d="M8 5.5v13l11-6.5z" />
      </svg>
      {t('game.play')}
    </a>
  ) : (
    <span class="go" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 12h14M13 6l6 6-6 6" />
      </svg>
    </span>
  )}
</div>

<style>
  .row {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto auto;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-3);
    border-top: 3px solid var(--line);
    text-decoration: none;
    isolation: isolate;
  }

  /* The accent wipes in from the left instead of the whole row blinking. */
  .row::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--row-accent);
    opacity: 0.14;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--mid) var(--ease-out);
  }

  .row:hover::before,
  .row:focus-within::before { transform: scaleX(1); }

  .num {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 800;
    color: var(--ink-soft);
    font-variant-numeric: tabular-nums;
  }

  .art {
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    border: 3px solid var(--line);
    border-radius: 22%;
    background: var(--row-accent);
    box-shadow: 4px 4px 0 var(--shadow-color);
    transform: rotate(-1.5deg);
    transition: transform var(--mid) var(--ease-out), box-shadow var(--mid) var(--ease-out);
  }

  .art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .row:hover .art,
  .row:focus-within .art {
    transform: translate(-2px, -2px) rotate(0deg);
    box-shadow: 7px 7px 0 var(--shadow-color);
  }

  .body,
  .copy {
    display: grid;
    gap: 0.35rem;
    min-width: 0;
  }

  .body--with-cover {
    grid-template-columns: clamp(4.75rem, 7vw, 5.5rem) minmax(0, 1fr);
    align-items: center;
    column-gap: var(--space-3);
  }

  .title { display: flex; align-items: baseline; gap: 0.75rem; flex-wrap: wrap; }
  .title h3 { margin: 0; font-size: var(--step-2); }

  /* Tek bir baglanti tum satiri tiklanabilir yapiyor; ustundeki oyna dugmesi
     kendi katmaninda kaldigi icin ic ice baglanti olusmuyor. */
  .cover { text-decoration: none; }
  .cover::after { content: ''; position: absolute; inset: 0; }

  .former {
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--ink-soft);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .tagline { color: var(--ink-soft); max-width: 52ch; }

  .meta { display: flex; align-items: center; gap: var(--space-3); }

  .platforms {
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--ink-soft);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .go {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 3px solid var(--line);
    background: var(--surface);
    color: var(--ink);
    transition: transform var(--fast) var(--ease-out), background var(--fast) var(--ease-out);
  }

  .row:hover .go,
  .row:focus-within .go {
    transform: translateX(4px);
    background: var(--row-accent);
    color: #fff;
  }

  .play {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 48px;
    padding: 0.5em 1.2em;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    text-decoration: none;
    /* Orange, not the game's own accent: on this site orange is what means
       "this does something", and white on a yellow accent would not read. */
    color: #fff;
    background: var(--orange);
    border: 3px solid var(--line);
    border-radius: 999px;
    box-shadow: 3px 3px 0 var(--shadow-color);
    white-space: nowrap;
    transition: transform var(--fast) var(--ease-out), box-shadow var(--fast) var(--ease-out);
  }

  .play:hover { transform: translate(-2px, -2px); box-shadow: 6px 6px 0 var(--shadow-color); }
  .play:active { transform: translate(1px, 1px); box-shadow: 1px 1px 0 var(--shadow-color); }

  @media (max-width: 60rem) {
    .row { grid-template-columns: auto minmax(0, 1fr) auto; }
    .meta { grid-column: 2 / -1; }
    .play,
    .go {
      grid-column: 3;
      grid-row: 1;
    }
  }

  @media (max-width: 40rem) {
    .row { grid-template-columns: auto minmax(0, 1fr); gap: var(--space-3); }
    .go { display: none; }
    .play { grid-column: 2 / -1; grid-row: auto; justify-self: start; }
    .meta { flex-wrap: wrap; gap: var(--space-2); }

    .body--with-cover {
      grid-template-columns: 4rem minmax(0, 1fr);
      column-gap: 0.75rem;
      align-items: start;
    }
  }
</style>
