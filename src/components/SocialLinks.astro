---
import { existsSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import type { SocialLink } from '../data/projects';

interface Props { links: SocialLink[]; size?: 'normal' | 'small' }
const { links, size = 'normal' } = Astro.props;

/**
 * Each link shows the platform's own logo as soon as a PNG named after its key
 * is dropped into public/media/social/. Until then it shows a tile in the
 * platform's colour, so a missing file never leaves a hole in the page.
 */
const withIcon = links.map((link) => {
  const src = `/media/social/${link.key}.png`;
  const onDisk = fileURLToPath(new URL(`../../public${src}`, import.meta.url));
  return { ...link, src, hasIcon: existsSync(onDisk) };
});
---

<ul class:list={['links', size === 'small' && 'small']}>
  {withIcon.map((link) => (
    <li>
      <a href={link.url} target="_blank" rel="me noopener" style={`--brand:${link.color}`}>
        <span class="icon">
          {link.hasIcon
            ? <img src={link.src} alt="" loading="lazy" width="48" height="48" />
            : <span aria-hidden="true">{link.label.charAt(0)}</span>}
        </span>
        {link.label}
      </a>
    </li>
  ))}
</ul>

<style>
  .links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  a {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 44px;
    font-family: var(--font-display);
    font-weight: 700;
    text-decoration: none;
    padding: 0.4rem 1.1rem 0.4rem 0.4rem;
    border: 3px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    color: var(--ink);
    box-shadow: 3px 3px 0 var(--shadow-color);
    transition: transform var(--fast) var(--ease-out), box-shadow var(--fast) var(--ease-out);
  }

  a:hover {
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 var(--brand);
  }

  a:active { transform: translate(1px, 1px); box-shadow: 1px 1px 0 var(--shadow-color); }

  .icon {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    border: 3px solid var(--line);
    background: var(--brand);
    color: #fff;
    font-weight: 800;
    font-size: 0.95rem;
    overflow: hidden;
    flex: none;
  }

  .icon img { width: 100%; height: 100%; object-fit: cover; }

  .small a { font-size: 0.92rem; padding: 0.3rem 0.85rem 0.3rem 0.3rem; }
  .small .icon { width: 1.7rem; height: 1.7rem; font-size: 0.8rem; }
</style>
