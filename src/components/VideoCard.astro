---
import type { Lang } from '../i18n/ui';
import type { Video } from '../data/projects';

interface Props { video: Video; lang: Lang }
const { video, lang } = Astro.props;
---

<article class="v" style={`--card-accent:${video.accent}`}>
  <div class="embed">
    <iframe
      src={`https://www.youtube-nocookie.com/embed/${video.youtube}`}
      title={video.title[lang]}
      loading="lazy"
      allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
      allowfullscreen
    ></iframe>
  </div>

  <h3>{video.title[lang]}</h3>
  <p class="meta">{video.role[lang]} · {video.year}</p>
  <p>{video.description[lang]}</p>
</article>

<style>
  .v h3 { margin-top: var(--space-3); margin-bottom: 0.15rem; }

  .meta {
    font-family: var(--font-display);
    font-size: var(--step--1);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-soft);
    margin-bottom: 0.6rem;
  }

  .v .embed { box-shadow: 6px 6px 0 var(--card-accent); }
</style>
