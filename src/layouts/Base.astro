---
import '@fontsource-variable/outfit';
import '@fontsource-variable/bricolage-grotesque';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { type Lang, canonicalPath, useTranslations } from '../i18n/ui';
import { site } from '../data/projects';

interface Props {
  lang: Lang;
  /** Language-neutral path, e.g. "/games" — used for the language switch. */
  path: string;
  title: string;
  description: string;
  accent?: string;
}

const { lang, path, title, description, accent } = Astro.props;
const t = useTranslations(lang);
const fullTitle = path === '/' ? `${site.name} — ${title}` : `${title} — ${site.name}`;
const canonical = new URL(canonicalPath(path, lang), Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F7C51E" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#14103C" media="(prefers-color-scheme: dark)" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={new URL(canonicalPath(path, 'en'), Astro.site)} />
    <link rel="alternate" hreflang="tr" href={new URL(canonicalPath(path, 'tr'), Astro.site)} />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />

    {accent && <style set:html={`:root{--accent:${accent}}`} />}

    {/* Marks the document as scripted before first paint, so the reveal
        animation only hides content when something can bring it back. */}
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>

  <body>
    <a class="skip" href="#main">{t('skip')}</a>
    <Header lang={lang} path={path} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />

    <script>
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
      const targets = document.querySelectorAll('[data-reveal]');

      if (reduced.matches) {
        targets.forEach((el) => el.classList.add('is-in'));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-in');
              observer.unobserve(entry.target);
            });
          },
          { rootMargin: '0px 0px -12% 0px', threshold: 0.1 },
        );

        targets.forEach((el) => observer.observe(el));
      }
    </script>

    <style>
      .skip {
        position: absolute;
        left: 1rem;
        top: -4rem;
        z-index: calc(var(--z-header) + 1);
        padding: 0.75rem 1.25rem;
        background: var(--orange);
        color: #fff;
        font-weight: 700;
        border-radius: 0 0 12px 12px;
        transition: top var(--fast) var(--ease-out);
      }

      .skip:focus-visible { top: 0; }
    </style>
  </body>
</html>
