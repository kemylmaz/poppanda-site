---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import mark from '../assets/mark.png';
import SocialLinks from '../components/SocialLinks.astro';
import { useTranslations, type Lang } from '../i18n/ui';
import { studio, team } from '../data/projects';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<Base lang={lang} path="/about" title={t('about.title')} description={studio.bio[0][lang]} accent="#7A5CC4">
  <section class="section">
    <div class="wrap">
      <header class="intro">
        <span class="kicker">{t('about.kicker')}</span>
        <h1>{t('about.title')}</h1>
        <hr class="divide" />
      </header>

      <div class="studio" data-reveal>
        <div>
          <h2>{studio.name}</h2>
          <p class="role">{studio.role[lang]}</p>
          <div class="prose">
            {studio.bio.map((para) => <p>{para[lang]}</p>)}
          </div>
          <SocialLinks links={studio.links} />
        </div>

        <Image class="studio__mark" src={mark} alt="" densities={[1, 2]} loading="lazy" />
      </div>
    </div>
  </section>

  {team.length > 0 && (
    <section class="section band">
      <div class="wrap">
        <h2 data-reveal>{t('about.team')}</h2>
        <div class="people">
          {team.map((person, i) => (
            <article class="panel person" data-reveal style={`--reveal-delay:${i * 80}ms`}>
              <h3>{person.name}</h3>
              {person.role[lang] && <p class="role">{person.role[lang]}</p>}
              {person.bio.map((para) => <p>{para[lang]}</p>)}
              <SocialLinks links={person.links} size="small" />
            </article>
          ))}
        </div>
      </div>
    </section>
  )}
</Base>

<style>
  .intro { margin-bottom: var(--space-5); }

  /* A rule instead of a subtitle: the heading lands, then the page opens. */
  .divide {
    height: 4px;
    margin: var(--space-4) 0 0;
    border: 0;
    background: var(--line);
  }

  .studio {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.42fr);
    gap: var(--space-5);
    align-items: center;
  }

  .studio__mark {
    width: min(100%, 12rem);
    margin-inline: auto;
    transform: rotate(3deg);
  }

  h2 { font-size: var(--step-3); margin-bottom: 0.15em; }

  .role {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-size: var(--step--1);
    color: var(--ink-soft);
    margin-bottom: var(--space-3);
  }

  .prose { font-size: 1.05em; margin-bottom: var(--space-4); }

  .people {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    margin-top: var(--space-4);
  }

  .person h3 { margin-bottom: 0.15em; }
  .person p { font-size: var(--step-0); }
  .person .role { margin-bottom: var(--space-3); }

  @media (max-width: 56rem) {
    .studio { grid-template-columns: 1fr; }
    .studio__mark { display: none; }
  }
</style>
