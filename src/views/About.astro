---
import Base from '../layouts/Base.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { useTranslations, type Lang } from '../i18n/ui';
import { team, site } from '../data/projects';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);

const [lead, ...rest] = team;
---

<Base lang={lang} path="/about" title={t('about.title')} description={t('about.lead')} accent="#7A5CC4">
  <section class="section">
    <div class="wrap">
      <header class="intro">
        <span class="kicker">{t('about.kicker')}</span>
        <h1>{t('about.title')}</h1>
        <p class="lead">{t('about.lead')}</p>
      </header>

      <div class="lead-person" data-reveal>
        <div class="lead-person__text">
          <h2>{lead.name}</h2>
          {lead.role[lang] && <p class="role">{lead.role[lang]}</p>}
          <div class="prose">
            {lead.bio.map((para) => <p>{para[lang]}</p>)}
          </div>
          <SocialLinks links={lead.links} />
        </div>

        <img class="lead-person__mark" src="/media/mark.png" alt="" width="309" height="512" loading="lazy" />
      </div>
    </div>
  </section>

  {rest.length > 0 && (
    <section class="section band">
      <div class="wrap">
        <h2 data-reveal>{t('about.team')}</h2>
        <div class="people">
          {rest.map((person, i) => (
            <article class="panel person" data-reveal style={`--reveal-delay:${i * 80}ms`}>
              <h3>{person.name}</h3>
              {person.role[lang] && <p class="role">{person.role[lang]}</p>}
              {person.bio.map((para) => <p>{para[lang]}</p>)}
              <SocialLinks links={person.links} size="small" />
            </article>
          ))}
        </div>
      </div>
    </section>
  )}
</Base>

<style>
  .intro { margin-bottom: var(--space-6); }

  .lead-person {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.5fr);
    gap: var(--space-5);
    align-items: center;
  }

  .lead-person__mark {
    width: min(100%, 16rem);
    margin-inline: auto;
    transform: rotate(3deg);
    filter: drop-shadow(8px 8px 0 var(--shadow-color));
  }

  h2 { font-size: var(--step-3); margin-bottom: 0.15em; }

  .role {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-size: var(--step--1);
    color: var(--ink-soft);
    margin-bottom: var(--space-3);
  }

  .prose { font-size: 1.05em; margin-bottom: var(--space-4); }

  .people {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    margin-top: var(--space-4);
  }

  .person h3 { margin-bottom: 0.15em; }
  .person p { font-size: var(--step-0); }
  .person .role { margin-bottom: var(--space-3); }

  @media (max-width: 56rem) {
    .lead-person { grid-template-columns: 1fr; }
    .lead-person__mark { display: none; }
  }
</style>
