---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { useTranslations, localizePath, type Lang } from '../i18n/ui';
import { formatDate, slugOf, type Post } from '../lib/blog';

interface Props { post: Post; lang: Lang }
const { post, lang } = Astro.props;
const t = useTranslations(lang);

const { Content } = await render(post);
---

<Base
  lang={lang}
  path={`/blog/${slugOf(post)}`}
  title={post.data.title}
  description={post.data.summary ?? post.data.title}
  accent="#7A5CC4"
>
  <article class="section">
    <div class="wrap--narrow">
      <a class="back" href={localizePath('/blog', lang)}>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M19 12H5M11 18l-6-6 6-6" />
        </svg>
        {t('blog.back')}
      </a>

      <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, lang)}</time>
      <h1>{post.data.title}</h1>

      {post.data.youtube && (
        <div class="embed">
          <iframe
            src={`https://www.youtube-nocookie.com/embed/${post.data.youtube}`}
            title={post.data.title}
            loading="lazy"
            allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          ></iframe>
        </div>
      )}

      <div class="prose">
        <Content />
      </div>
    </div>
  </article>
</Base>

<style>
  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step--1);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    margin-bottom: var(--space-4);
  }

  .back:hover { text-decoration: underline; text-decoration-color: var(--orange); }
  .back svg { transition: transform var(--fast) var(--ease-out); }
  .back:hover svg { transform: translateX(-3px); }

  time {
    display: block;
    font-family: var(--font-display);
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin-bottom: 0.4rem;
  }

  h1 { font-size: var(--step-3); margin-bottom: var(--space-4); }

  .embed { margin-bottom: var(--space-5); }

  .prose { font-size: 1.05em; }
  .prose :global(h2) { font-size: var(--step-2); margin-top: var(--space-5); }
  .prose :global(h3) { margin-top: var(--space-4); }
  .prose :global(img) {
    border: 3px solid var(--line);
    border-radius: var(--radius);
    margin-block: var(--space-4);
  }
  .prose :global(blockquote) {
    margin: var(--space-4) 0;
    padding-left: var(--space-3);
    border-left: 4px solid var(--orange);
    color: var(--ink-soft);
  }
  .prose :global(hr) {
    height: 3px;
    border: 0;
    background: var(--line-soft);
    margin-block: var(--space-5);
  }
  .prose :global(code) {
    background: var(--bg-alt);
    padding: 0.15em 0.4em;
    border-radius: 6px;
    font-size: 0.92em;
  }
  .prose :global(pre) {
    background: var(--navy-deep);
    color: var(--bg);
    padding: var(--space-3);
    border-radius: var(--radius);
    overflow-x: auto;
  }
  .prose :global(pre code) { background: none; padding: 0; }
</style>
