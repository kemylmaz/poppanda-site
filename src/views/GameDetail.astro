---
import Base from '../layouts/Base.astro';
import { useTranslations, localizePath, type Lang } from '../i18n/ui';
import type { Game } from '../data/projects';

interface Props { game: Game; lang: Lang }
const { game, lang } = Astro.props;
const t = useTranslations(lang);

const facts = [
  { label: t('game.status'), value: t(`status.${game.status}`) },
  { label: t('game.year'), value: game.year },
  { label: t('game.role'), value: game.role[lang] },
  { label: t('game.engine'), value: game.engine },
  ...(game.platforms ? [{ label: t('game.platforms'), value: game.platforms.join(', ') }] : []),
];
---

<Base
  lang={lang}
  path={`/games/${game.slug}`}
  title={game.title}
  description={game.tagline[lang]}
  accent={game.accent}
>
  <section class="masthead" style={`--game-accent:${game.accent}`}>
    <div class="wrap">
      <a class="back" href={localizePath('/games', lang)}>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M19 12H5M11 18l-6-6 6-6" />
        </svg>
        {t('game.back')}
      </a>

      <h1>{game.title}</h1>
      {game.formerTitle && <p class="former">{t('game.former')}: {game.formerTitle}</p>}
      <p class="lead">{game.tagline[lang]}</p>

      {(game.playUrl || game.steamUrl || game.sourceUrl) && (
        <div class="actions">
          {game.playUrl && <a class="btn btn--primary" href={game.playUrl}>{t('game.play')}</a>}
          {game.steamUrl && <a class="btn btn--primary" href={game.steamUrl}>{t('game.steam')}</a>}
          {game.sourceUrl && <a class="btn" href={game.sourceUrl}>{t('game.source')}</a>}
        </div>
      )}
    </div>
  </section>

  <div class="wrap columns">
    <div class="prose" data-reveal>
      {game.youtube && (
        <div class="embed trailer">
          <iframe
            src={`https://www.youtube-nocookie.com/embed/${game.youtube}`}
            title={game.title}
            loading="lazy"
            allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          ></iframe>
        </div>
      )}

      {game.description.map((para) => <p>{para[lang]}</p>)}

      {game.shots && game.shots.length > 0 && (
        <div class="shots">
          {game.shots.map((shot) => (
            <img src={shot.src} alt={shot.alt[lang]} loading="lazy" />
          ))}
        </div>
      )}
    </div>

    <aside class="facts" data-reveal>
      <dl>
        {facts.map((fact) => (
          <div>
            <dt>{fact.label}</dt>
            <dd>{fact.value}</dd>
          </div>
        ))}
      </dl>
    </aside>
  </div>
</Base>

<style>
  /* A full-width band in the game's own colour, so each project announces
     itself before a single word is read. */
  .masthead {
    position: relative;
    padding-block: var(--space-6);
    background:
      linear-gradient(to bottom, color-mix(in srgb, var(--game-accent) 22%, transparent), transparent),
      var(--bg-alt);
    border-bottom: 3px solid var(--line);
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    font-family: var(--font-display);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: var(--step--1);
    text-decoration: none;
    margin-bottom: var(--space-3);
  }

  .back:hover { text-decoration: underline; text-decoration-color: var(--game-accent); }
  .back svg { transition: transform var(--fast) var(--ease-out); }
  .back:hover svg { transform: translateX(-3px); }

  .masthead h1 { margin-bottom: 0.2em; }

  .former {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ink-soft);
    margin-bottom: 0.8rem;
  }

  .actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-4); }

  .columns {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    align-items: start;
    gap: var(--space-5);
    padding-block: var(--space-6);
  }

  .prose { font-size: var(--step-0); }
  .prose p { font-size: 1.05em; }
  .trailer { margin-bottom: var(--space-4); }

  .facts {
    position: sticky;
    top: 6.5rem;
    background: var(--surface);
    border: 3px solid var(--line);
    border-radius: var(--radius);
    box-shadow: 6px 6px 0 var(--shadow-color);
    padding: var(--space-4);
  }

  .facts dl { margin: 0; display: grid; gap: var(--space-3); }

  .facts dt {
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .facts dd {
    margin: 0.1rem 0 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-1);
    line-height: 1.15;
  }

  .shots {
    margin-top: var(--space-5);
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
  }

  .shots img {
    border: 3px solid var(--line);
    border-radius: var(--radius);
    box-shadow: 6px 6px 0 var(--shadow-color);
  }

  @media (max-width: 56rem) {
    .columns { grid-template-columns: 1fr; }
    .facts { position: static; }
  }
</style>
