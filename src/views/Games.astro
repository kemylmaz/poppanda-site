---
import Base from '../layouts/Base.astro';
import GameRow from '../components/GameRow.astro';
import { useTranslations, type Lang } from '../i18n/ui';
import { games } from '../data/projects';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<Base lang={lang} path="/games" title={t('games.title')} description={t('games.lead')}>
  <section class="section">
    <div class="wrap">
      <header class="intro">
        <span class="kicker">{t('games.kicker')}</span>
        <h1>{t('games.title')}</h1>
        <p class="lead">{t('games.lead')}</p>
      </header>

      {games.length > 0 ? (
        <div class="rows">
          {games.map((game, i) => <GameRow game={game} lang={lang} index={i} />)}
        </div>
      ) : (
        <p class="muted">{t('empty')}</p>
      )}
    </div>
  </section>
</Base>

<style>
  .intro { margin-bottom: var(--space-6); }
  .rows { border-bottom: 3px solid var(--line); }
</style>
