---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import mark from '../assets/mark.png';
import GameRow from '../components/GameRow.astro';
import { useTranslations, localizePath, type Lang } from '../i18n/ui';
import { games, team } from '../data/projects';
import { postsFor, slugOf, formatDate } from '../lib/blog';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);

const playable = games.filter((g) => g.playable);
const latestPosts = (await postsFor(lang)).slice(0, 3);

const stats = [
  { value: String(games.length), label: t('stat.games') },
  { value: '2026', label: t('stat.since') },
  { value: String(team.length), label: t('stat.people') },
];
---

<Base lang={lang} path="/" title={t('home.title')} description={t('home.lead')}>
  <section class="hero">
    <div class="wrap hero__inner">
      <div class="hero__text">
        <span class="kicker">{t('home.kicker')}</span>
        <h1>{t('home.title')}</h1>
        <p class="lead">{t('home.lead')}</p>

        <div class="actions">
          <a class="btn btn--primary" href={localizePath('/games', lang)}>{t('home.cta.games')}</a>
          <a class="btn btn--ghost" href={localizePath('/about', lang)}>{t('nav.about')}</a>
        </div>
      </div>

      <div class="hero__mark">
        <Image src={mark} alt="" densities={[1, 2]} loading="eager" />
      </div>
    </div>

    <dl class="stats wrap">
      {stats.map((stat) => (
        <div>
          <dt>{stat.label}</dt>
          <dd>{stat.value}</dd>
        </div>
      ))}
    </dl>
  </section>

  {playable.length > 0 && (
    <section class="section">
      <div class="wrap">
        <header class="head" data-reveal>
          <div>
            <h2>{t('home.featured')}</h2>
            <p class="head__note muted">{t('home.playLead')}</p>
          </div>
        </header>

        <div class="rows">
          {playable.map((game, i) => <GameRow game={game} lang={lang} index={i} />)}
        </div>
      </div>
    </section>
  )}

  {latestPosts.length > 0 && (
    <section class="section band">
      <div class="wrap">
        <header class="head" data-reveal>
          <h2>{t('blog.title')}</h2>
          <a class="more" href={localizePath('/blog', lang)}>{t('blog.back')}</a>
        </header>

        <ul class="posts">
          {latestPosts.map((post, i) => (
            <li data-reveal style={`--reveal-delay:${i * 60}ms`}>
              <a href={localizePath(`/blog/${slugOf(post)}`, lang)}>
                <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, lang)}</time>
                <h3>{post.data.title}</h3>
                {post.data.summary && <p class="muted">{post.data.summary}</p>}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

</Base>

<style>
  .hero { padding-top: var(--space-6); }

  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    align-items: center;
    gap: var(--space-5);
  }

  .hero h1 { max-width: 12ch; }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }

  /* The panda leans a little and straightens up when the pointer arrives. */
  .hero__mark img {
    width: min(100%, 15rem);
    margin-inline: auto;
    transform: rotate(-3deg);
    transition: transform 400ms var(--ease-out);
  }

  .hero__mark:hover img { transform: rotate(0deg) translateY(-6px); }

  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(8rem, 1fr));
    gap: var(--space-4);
    margin-block: var(--space-6);
    padding-top: var(--space-4);
    border-top: 3px solid var(--line);
  }

  .stats div { display: grid; gap: 0.15rem; }

  .stats dt {
    order: 2;
    font-size: var(--step--1);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ink-soft);
  }

  .stats dd {
    order: 1;
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  .head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-bottom: var(--space-4);
  }

  .head h2 { margin: 0; }
  .head__note { margin: 0.35rem 0 0; font-size: var(--step--1); }

  .more {
    font-family: var(--font-display);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    text-decoration-color: var(--orange);
  }

  .rows { border-bottom: 3px solid var(--line); }

  .posts { list-style: none; margin: 0; padding: 0; border-top: 3px solid var(--line); }
  .posts li { border-bottom: 3px solid var(--line); }

  .posts a {
    display: block;
    padding: var(--space-3);
    text-decoration: none;
    transition: background var(--fast) var(--ease-out);
  }

  .posts a:hover, .posts a:focus-visible { background: var(--surface); }

  .posts time {
    font-family: var(--font-display);
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .posts h3 { margin: 0.2rem 0 0.3rem; }
  .posts p { margin: 0; }

  @media (max-width: 56rem) {
    .hero__inner { grid-template-columns: 1fr; }
    .hero__mark { order: -1; }
    .hero__mark img { width: min(52%, 11rem); }
  }
</style>
