---
import Base from '../layouts/Base.astro';
import GameCard from '../components/GameCard.astro';
import VideoCard from '../components/VideoCard.astro';
import { useTranslations, localizePath, type Lang } from '../i18n/ui';
import { games, videos } from '../data/projects';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);

const featuredGames = games.filter((g) => g.featured);
const featuredVideos = videos.filter((v) => v.featured).slice(0, 2);
---

<Base
  lang={lang}
  path="/"
  title={t('home.title')}
  description={t('home.lead')}
>
  <section class="hero">
    <div class="wrap">
      <span class="kicker">{t('home.kicker')}</span>
      <h1>{t('home.title')}</h1>
      <p class="lead">{t('home.lead')}</p>

      <div class="actions">
        <a class="btn btn--primary" href={localizePath('/games', lang)}>{t('home.cta.games')}</a>
        <a class="btn" href={localizePath('/video', lang)}>{t('home.cta.video')}</a>
      </div>
    </div>
  </section>

  {featuredGames.length > 0 && (
    <section class="section">
      <div class="wrap">
        <h2>{t('home.featured')}</h2>
        <div class="grid">
          {featuredGames.map((game) => <GameCard game={game} lang={lang} />)}
        </div>
      </div>
    </section>
  )}

  {featuredVideos.length > 0 && (
    <section class="section">
      <div class="wrap">
        <h2>{t('video.title')}</h2>
        <div class="grid">
          {featuredVideos.map((video) => <VideoCard video={video} lang={lang} />)}
        </div>
      </div>
    </section>
  )}
</Base>

<style>
  .hero { padding-block: clamp(3.5rem, 2rem + 8vw, 8rem); }
  .hero h1 { max-width: 14ch; }
  .hero .lead { max-width: 46ch; }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 2rem;
  }
</style>
