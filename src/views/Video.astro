---
import Base from '../layouts/Base.astro';
import VideoCard from '../components/VideoCard.astro';
import { useTranslations, type Lang } from '../i18n/ui';
import { videos, site } from '../data/projects';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);

const channel = site.links.find((link) => link.key === 'youtube');
---

<Base lang={lang} path="/video" title={t('video.title')} description={t('video.lead')} accent="#7A5CC4">
  <section class="section">
    <div class="wrap">
      <header class="intro">
        <span class="kicker">{t('video.kicker')}</span>
        <h1>{t('video.title')}</h1>
        <p class="lead">{t('video.lead')}</p>
      </header>

      {videos.length > 0 ? (
        <div class="grid">
          {videos.map((video, i) => (
            <div data-reveal style={`--reveal-delay:${i * 80}ms`}>
              <VideoCard video={video} lang={lang} />
            </div>
          ))}
        </div>
      ) : (
        <div class="empty panel">
          <h2>{t('empty.title')}</h2>
          <p class="muted">{t('empty')}</p>
          {channel && <a class="btn btn--primary" href={channel.url} target="_blank" rel="noopener">{t('empty.channel')}</a>}
        </div>
      )}
    </div>
  </section>
</Base>

<style>
  .intro { margin-bottom: var(--space-6); }

  .grid {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr));
  }

  .empty { max-width: 40rem; }
  .empty h2 { font-size: var(--step-2); }
</style>
